        <rdf:value>&lt;div data-schema-version=&quot;9&quot;&gt;&lt;p&gt;new read!&lt;/p&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
    <bib:Memo rdf:about="#item_85">
        <rdf:value>&lt;div data-citation-items=&quot;%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FJK7Z8EQS%22%5D%2C%22itemData%22%3A%7B%22id%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FJK7Z8EQS%22%2C%22type%22%3A%22article-journal%22%2C%22abstract%22%3A%22Antimicrobial%20resistance%20(AMR)%20is%20widespread%2C%20with%20resistant%20pathogens%20found%20not%20only%20in%20the%20clinic%20but%20throughout%20the%20natural%20and%20built%20environments.%20It%20is%20unclear%2C%20however%2C%20to%20what%20extent%20AMR%20should%20be%20expected%20to%20persist%20in%20the%20environment%3A%20Laboratory%20experiments%20have%20suggested%20that%20resistance%20is%20typically%20costly%2C%20and%20hence%20should%20be%20selected%20against.%20However%2C%20such%20studies%20may%20not%20generalize%20to%20broader%20environmental%20settings.%20As%20such%2C%20we%20estimated%20the%20fitness%20of%20six%20AMR%20mutants%20of%20Escherichia%20coli%20in%20ten%20media%20reflecting%20ecological%20niches%2C%20human%20hosts%2C%20and%20standard%20lab%20conditions.%20We%20found%20extensive%20evidence%20for%20genotype%20%C3%97%20environment%20interactions%2C%20with%20different%20genotypes%20favored%20in%20different%20environments.%20Resistance%20alleles%20did%20not%20suffer%20a%20cost%20in%20some%20environments%2C%20raising%20the%20possibility%20of%20environmental%20reservoirs%20of%20resistance.%20Interestingly%2C%20fitness%20tended%20to%20be%20higher%20in%20lower%20quality%20environments.%20Our%20findings%20emphasize%20the%20need%20to%20consider%20the%20ecology%20and%20evolution%20of%20resistance%20in%20the%20broader%20environment%20in%20the%20management%20of%20AMR.%22%2C%22container-title%22%3A%22Evolutionary%20Ecology%22%2C%22DOI%22%3A%2210.1007%2Fs10682-019-10027-y%22%2C%22ISSN%22%3A%220269-7653%2C%201573-8477%22%2C%22issue%22%3A%223%22%2C%22journalAbbreviation%22%3A%22Evol%20Ecol%22%2C%22language%22%3A%22en%22%2C%22page%22%3A%22379-390%22%2C%22source%22%3A%22DOI.org%20(Crossref)%22%2C%22title%22%3A%22The%20effect%20of%20environmental%20heterogeneity%20on%20the%20fitness%20of%20antibiotic%20resistance%20mutations%20in%20Escherichia%20coli%22%2C%22URL%22%3A%22https%3A%2F%2Flink.springer.com%2F10.1007%2Fs10682-019-10027-y%22%2C%22volume%22%3A%2234%22%2C%22author%22%3A%5B%7B%22family%22%3A%22Clarke%22%2C%22given%22%3A%22Leah%22%7D%2C%7B%22family%22%3A%22Pelin%22%2C%22given%22%3A%22Adrian%22%7D%2C%7B%22family%22%3A%22Phan%22%2C%22given%22%3A%22Michael%22%7D%2C%7B%22family%22%3A%22Wong%22%2C%22given%22%3A%22Alex%22%7D%5D%2C%22accessed%22%3A%7B%22date-parts%22%3A%5B%5B%222026%22%2C2%2C2%5D%5D%7D%2C%22issued%22%3A%7B%22date-parts%22%3A%5B%5B%222020%22%2C6%5D%5D%7D%7D%7D%5D&quot; data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FBD86CBAJ%22%2C%22pageLabel%22%3A%22383%22%2C%22position%22%3A%7B%22pageIndex%22%3A4%2C%22rects%22%3A%5B%5B58.11470181200001%2C77.78370385699996%2C392.60780180837105%2C88.68970385699997%5D%2C%5B46.78120181200001%2C66.27920385699996%2C187.08670181199997%2C77.18520385699996%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FJK7Z8EQS%22%5D%2C%22locator%22%3A%22383%22%7D%7D&quot;&gt;“The G × E interaction effect implies that the relative fitness effect of a given mutation is dependent on the assay environment”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FJK7Z8EQS%22%5D%2C%22locator%22%3A%22383%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Clarke et al., 2020, p. 383&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
&lt;p&gt;“M9 minimal medium + glucose is perhaps the most representative environment, showing positive correlations with soil, artificial colon, and anaerobic sludge” &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FJK7Z8EQS%22%5D%2C%22locator%22%3A%22387%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Clarke et al., 2020, p. 387&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FBD86CBAJ%22%2C%22pageLabel%22%3A%22387%22%2C%22position%22%3A%7B%22pageIndex%22%3A8%2C%22rects%22%3A%5B%5B258.77370181199996%2C585.045187011%2C392.60970181200025%2C595.951187011%5D%2C%5B46.771701812%2C573.540687011%2C392.6239518156293%2C584.446687011%5D%2C%5B46.771701812%2C562.036187011%2C162.263201812%2C572.942187011%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FJK7Z8EQS%22%5D%2C%22locator%22%3A%22387%22%7D%7D&quot;&gt;“LB broth is a standard medium for laboratory microbiology, and our findings suggest that it may not be representative of environments in the natural world.”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FJK7Z8EQS%22%5D%2C%22locator%22%3A%22387%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Clarke et al., 2020, p. 387&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FBD86CBAJ%22%2C%22pageLabel%22%3A%22387%22%2C%22position%22%3A%7B%22pageIndex%22%3A8%2C%22rects%22%3A%5B%5B135.938701812%2C400.9731870109999%2C392.6382018119999%2C411.8791870109999%5D%2C%5B46.771701812%2C389.4686870109999%2C392.6182518120003%2C400.3746870109999%5D%2C%5B46.771701812%2C377.96418701099986%2C392.56125180837097%2C388.87018701099987%5D%2C%5B46.771701812%2C366.45968701099986%2C100.51320181200002%2C377.36568701099986%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FJK7Z8EQS%22%5D%2C%22locator%22%3A%22387%22%7D%7D&quot;&gt;“Here, we found that competitive fitness tended to be higher in lower quality (higher stress) environments (Fig. 3, Table 2). This indicates that costs of resistance are lower—and that beneficial effects of resistance mutations are higher—in low yield environments.”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FJK7Z8EQS%22%5D%2C%22locator%22%3A%22387%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Clarke et al., 2020, p. 387&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
