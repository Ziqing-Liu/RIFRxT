    <bib:Article rdf:about="https://linkinghub.elsevier.com/retrieve/pii/S258900422030208X">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:25890042"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Rodríguez-Verdugo</foaf:surname>
