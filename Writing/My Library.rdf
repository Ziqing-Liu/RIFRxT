            <dcterms:URI>
                <rdf:value>https://pnas.org/doi/full/10.1073/pnas.1213613110</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-02-17 01:19:08</dcterms:dateSubmitted>
        <bib:pages>571-576</bib:pages>
    </bib:Article>
