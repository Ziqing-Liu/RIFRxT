                <rdf:value>https://www.annualreviews.org/doi/10.1146/annurev-biophys-112221-074832</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-03-02 00:27:33</dcterms:dateSubmitted>
        <bib:pages>499-526</bib:pages>
    </bib:Article>
