    <bib:Article rdf:about="https://pnas.org/doi/full/10.1073/pnas.95.6.2908">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>95</prism:volume>
