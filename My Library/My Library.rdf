    <bib:Article rdf:about="https://onlinelibrary.wiley.com/doi/10.1046/j.1525-142x.2001.003002073.x">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:1520-541X,%201525-142X"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Yampolsky</foaf:surname>
                        <foaf:givenName>Lev Y.</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Stoltzfus</foaf:surname>
                        <foaf:givenName>Arlin</foaf:givenName>
                    </foaf:Person>
