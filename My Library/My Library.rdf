        <bib:pages>480-490</bib:pages>
    </bib:Article>
    <bib:Journal rdf:about="urn:issn:1471-0056,%201471-0064">
        <prism:volume>15</prism:volume>
        <dc:title>Nature Reviews Genetics</dc:title>
        <dc:identifier>DOI 10.1038/nrg3744</dc:identifier>
        <prism:number>7</prism:number>
        <dcterms:alternative>Nat Rev Genet</dcterms:alternative>
        <dc:identifier>ISSN 1471-0056, 1471-0064</dc:identifier>
    </bib:Journal>
    <bib:Memo rdf:about="#item_134">
        <rdf:value>&lt;div data-citation-items=&quot;%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FQ9RQR3KI%22%5D%2C%22itemData%22%3A%7B%22id%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FQ9RQR3KI%22%2C%22type%22%3A%22article-journal%22%2C%22container-title%22%3A%22Nature%20Reviews%20Genetics%22%2C%22DOI%22%3A%2210.1038%2Fnrg3744%22%2C%22ISSN%22%3A%221471-0056%2C%201471-0064%22%2C%22issue%22%3A%227%22%2C%22journalAbbreviation%22%3A%22Nat%20Rev%20Genet%22%2C%22language%22%3A%22en%22%2C%22page%22%3A%22480-490%22%2C%22source%22%3A%22DOI.org%20(Crossref)%22%2C%22title%22%3A%22Empirical%20fitness%20landscapes%20and%20the%20predictability%20of%20evolution%22%2C%22URL%22%3A%22https%3A%2F%2Fwww.nature.com%2Farticles%2Fnrg3744%22%2C%22volume%22%3A%2215%22%2C%22author%22%3A%5B%7B%22family%22%3A%22De%20Visser%22%2C%22given%22%3A%22J.%20Arjan%20G.M.%22%7D%2C%7B%22family%22%3A%22Krug%22%2C%22given%22%3A%22Joachim%22%7D%5D%2C%22accessed%22%3A%7B%22date-parts%22%3A%5B%5B%222026%22%2C2%2C12%5D%5D%7D%2C%22issued%22%3A%7B%22date-parts%22%3A%5B%5B%222014%22%2C7%5D%5D%7D%7D%7D%5D&quot; data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FBR5RE3MR%22%2C%22pageLabel%22%3A%22484%22%2C%22position%22%3A%7B%22pageIndex%22%3A4%2C%22rects%22%3A%5B%5B278.2005894094%2C137.93999897199998%2C341.8645880254%2C147.80730098026999%5D%2C%5B142.29919433%2C126.93999897199998%2C341.80118999300015%2C136.24119876979998%5D%2C%5B142.29919433%2C115.939998972%2C341.81958999260013%2C125.24119876980001%5D%2C%5B142.29919433%2C104.939998972%2C341.8563899918001%2C114.24119876980001%5D%2C%5B142.29919433%2C93.939998972%2C341.8379899921999%2C103.24119876980001%5D%2C%5B142.29919433%2C82.939998972%2C256.3791918500001%2C92.24119876980001%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FQ9RQR3KI%22%5D%2C%22locator%22%3A%22484%22%7D%7D&quot;&gt;“A general finding of these experiments is that the amount of parallelism depends strongly on the organizational level; that is, there are higher frequencies of shared adaptive changes at the level of genes and metabolic pathways than at the level of nucleotide substitutions”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FQ9RQR3KI%22%5D%2C%22locator%22%3A%22484%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;De Visser and Krug, 2014, p. 484&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FBR5RE3MR%22%2C%22pageLabel%22%3A%22484%22%2C%22position%22%3A%7B%22pageIndex%22%3A4%2C%22rects%22%3A%5B%5B153.63780212%2C71.939998972%2C341.87899802780015%2C81.24119876980001%5D%2C%5B142.29919433%2C60.939998972000005%2C341.8287899924%2C70.24119876980001%5D%2C%5B142.29919433%2C49.939998972%2C313.5847906064002%2C59.24119876979999%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FQ9RQR3KI%22%5D%2C%22locator%22%3A%22484%22%7D%7D&quot;&gt;“Repeatability in replicate experiments is a weak form of predictability, as the deterministic nature of the process can be ascertained only in retrospect.”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FQ9RQR3KI%22%5D%2C%22locator%22%3A%22484%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;De Visser and Krug, 2014, p. 484&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
&lt;p&gt;A high &lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FBR5RE3MR%22%2C%22pageLabel%22%3A%22484%22%2C%22position%22%3A%7B%22pageIndex%22%3A4%2C%22rects%22%3A%5B%5B353.19680786%2C709.9400142320001%2C552.6344035243992%2C719.2412140298001%5D%2C%5B353.19680786%2C698.9400142320001%2C552.7559738488001%2C708.2412140298001%5D%2C%5B353.19680786%2C687.9400142320001%2C552.7540035217999%2C697.2412140298001%5D%2C%5B353.19680786%2C676.9400142320001%2C552.749512814%2C686.8073162502701%5D%2C%5B353.19680786%2C665.9400142320001%2C425.7388062830001%2C675.8073162502701%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FQ9RQR3KI%22%5D%2C%22locator%22%3A%22484%22%7D%7D&quot;&gt;“degree of repeatability is a necessary but insufficient condition for the more challenging task of forward prediction, which requires additional knowledge about the mechanistic basis of the traits under selection58 and the adaptive process”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FQ9RQR3KI%22%5D%2C%22locator%22%3A%22484%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;De Visser and Krug, 2014, p. 484&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FBR5RE3MR%22%2C%22pageLabel%22%3A%22484%22%2C%22position%22%3A%7B%22pageIndex%22%3A4%2C%22rects%22%3A%5B%5B42.5196991%2C213.61399889999998%2C97.64469910000007%2C220.3619989%5D%2C%5B42.5196991%2C204.61399889999998%2C88.97869910000004%2C211.3619989%5D%2C%5B42.5196991%2C195.8479989%2C100.62969910000002%2C201.9969989%5D%2C%5B42.5196991%2C186.8479989%2C126.19419910000008%2C192.9969989%5D%2C%5B42.5196991%2C177.8479989%2C110.11969910000003%2C183.9969989%5D%2C%5B42.5196991%2C168.8479989%2C128.77469910000005%2C174.9969989%5D%2C%5B42.5196991%2C159.8479989%2C127.44869910000006%2C165.9969989%5D%2C%5B42.5196991%2C150.8479989%2C119.18719910000003%2C156.9969989%5D%2C%5B42.5196991%2C141.8479989%2C114.56569910000005%2C147.9969989%5D%2C%5B42.5196991%2C132.8479989%2C72.3936991%2C138.9969989%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FQ9RQR3KI%22%5D%2C%22locator%22%3A%22484%22%7D%7D&quot;&gt;“Strong-selectionweak-mutation (SSWM). A regime of population dynamics in which beneficial mutations are sufficiently rare to arise and fix independently, while selection is strong enough to prevent the fixation of deleterious mutations.”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FQ9RQR3KI%22%5D%2C%22locator%22%3A%22484%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;De Visser and Krug, 2014, p. 484&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FBR5RE3MR%22%2C%22pageLabel%22%3A%22483%22%2C%22position%22%3A%7B%22pageIndex%22%3A3%2C%22rects%22%3A%5B%5B42.5196991%2C663.1968999%2C84.95369910000004%2C669.9448999%5D%2C%5B42.5196991%2C654.4308999%2C111.55619910000004%2C660.5798999%5D%2C%5B42.5196991%2C645.4308999%2C123.81519910000003%2C651.5798999%5D%2C%5B42.5196991%2C636.4308999%2C123.80219910000007%2C642.5798999%5D%2C%5B42.5196991%2C627.4308999%2C104.72469910000005%2C633.5798999%5D%2C%5B42.5196991%2C618.4308999%2C110.41869910000005%2C624.5798999%5D%2C%5B42.5196991%2C609.4308999%2C103.54169910000005%2C615.5798999%5D%2C%5B42.5196991%2C600.4308999%2C77.99019910000003%2C606.5798999%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FQ9RQR3KI%22%5D%2C%22locator%22%3A%22483%22%7D%7D&quot;&gt;“Sign epistasis Epistatic interaction that affects the sign of mutational effects on fitness, such that a given mutation can be deleterious or beneficial depending on genetic background.”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FQ9RQR3KI%22%5D%2C%22locator%22%3A%22483%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;De Visser and Krug, 2014, p. 483&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;h2&gt;1. Predictability requires a specific &lt;strong&gt;population-genetic regime&lt;/strong&gt;&lt;/h2&gt;
&lt;p&gt;The paper’s strongest claims apply under the &lt;strong&gt;strong-selection–weak-mutation (SSWM)&lt;/strong&gt; regime nrg3744.&lt;/p&gt;
&lt;p&gt;This means:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
&lt;strong&gt;Selection is strong&lt;/strong&gt;&lt;br&gt;Beneficial mutations reliably increase fitness and deleterious ones do not fix.
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Mutation supply is low&lt;/strong&gt;&lt;br&gt;New mutations arise &lt;strong&gt;one at a time&lt;/strong&gt;, so:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
The population is effectively &lt;strong&gt;monomorphic&lt;/strong&gt;
&lt;/li&gt;
&lt;li&gt;
Each mutation either fixes or is lost before the next appears
&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;➡️ Under SSWM, evolution is constrained to &lt;strong&gt;strictly fitness-increasing (“uphill”) paths only&lt;/strong&gt;.&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;2. The fitness landscape must contain &lt;strong&gt;sign epistasis&lt;/strong&gt;&lt;/h2&gt;
&lt;p&gt;Predictability does &lt;em&gt;not&lt;/em&gt; arise from smooth landscapes — it arises from &lt;strong&gt;constraint&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;The key condition is:&lt;/p&gt;
&lt;blockquote&gt;
&lt;p&gt;&lt;strong&gt;Sign epistasis is present&lt;/strong&gt;&lt;br&gt;(the fitness effect of a mutation depends on genetic background) nrg3744&lt;/p&gt;
&lt;/blockquote&gt;
&lt;p&gt;Consequences:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
Many mutation orders become &lt;strong&gt;inaccessible&lt;/strong&gt;
&lt;/li&gt;
&lt;li&gt;
Only a &lt;strong&gt;small subset of mutational trajectories&lt;/strong&gt; can reach high fitness
&lt;/li&gt;
&lt;li&gt;
Some adaptive paths are completely blocked
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;This is the formal result:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
&lt;strong&gt;Sign epistasis ⇔ limited pathway accessibility&lt;/strong&gt;
&lt;/li&gt;
&lt;li&gt;
Without sign epistasis → &lt;em&gt;all&lt;/em&gt; paths are accessible → low predictability
&lt;/li&gt;
&lt;/ul&gt;
&lt;hr&gt;
&lt;h2&gt;3. Evolution is most predictable when &lt;strong&gt;only a few accessible paths exist&lt;/strong&gt;&lt;/h2&gt;
&lt;p&gt;Predictability is highest when:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
The number of &lt;strong&gt;selectively accessible paths&lt;/strong&gt; is small
&lt;/li&gt;
&lt;li&gt;
Most possible mutational orders are forbidden by fitness valleys
&lt;/li&gt;
&lt;li&gt;
The landscape has &lt;strong&gt;ruggedness&lt;/strong&gt;, but not complete randomness
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Empirical landscapes often show:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
100+ possible mutation orders
&lt;/li&gt;
&lt;li&gt;
Only ~5–20 accessible under selection
&lt;/li&gt;
&lt;li&gt;
Often &lt;strong&gt;one or two paths dominate&lt;/strong&gt; the probability mass nrg3744
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;➡️ This produces &lt;strong&gt;retrospective and forward predictability&lt;/strong&gt;.&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;4. Population size must be &lt;strong&gt;intermediate&lt;/strong&gt;&lt;/h2&gt;
&lt;p&gt;This is one of the paper’s most subtle points.&lt;/p&gt;
&lt;h3&gt;Predictability is &lt;strong&gt;maximal when&lt;/strong&gt;:&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;
Population size is large enough for &lt;strong&gt;clonal interference&lt;/strong&gt;
&lt;/li&gt;
&lt;li&gt;
But small enough to &lt;strong&gt;prevent valley crossing&lt;/strong&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Formally:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
&lt;strong&gt;Nμ ≳ 1&lt;/strong&gt; → multiple beneficial mutations compete
&lt;/li&gt;
&lt;li&gt;
&lt;strong&gt;Nμ² ≪ 1&lt;/strong&gt; → valley crossing is rare nrg3744
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;In this regime:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
The largest-effect mutation fixes almost deterministically
&lt;/li&gt;
&lt;li&gt;
Evolution follows &lt;strong&gt;“greedy” adaptive walks&lt;/strong&gt;
&lt;/li&gt;
&lt;li&gt;
The same paths are repeatedly used
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Too small → stochastic&lt;br&gt;Too large → valley crossing → unpredictability&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;5. Fitness must be reasonably well-aligned with the measured phenotype&lt;/h2&gt;
&lt;p&gt;The paper emphasizes that predictability depends on how well the measured trait maps to fitness.&lt;/p&gt;
&lt;p&gt;Predictability is strongest when:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
The measured proxy (e.g. resistance, growth rate) is &lt;strong&gt;monotonic with fitness&lt;/strong&gt;
&lt;/li&gt;
&lt;li&gt;
The environment is &lt;strong&gt;constant&lt;/strong&gt;
&lt;/li&gt;
&lt;li&gt;
Selection pressure is stable
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Otherwise:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
Path probabilities change
&lt;/li&gt;
&lt;li&gt;
Predictability collapses nrg3744
&lt;/li&gt;
&lt;/ul&gt;
&lt;hr&gt;
&lt;h2&gt;6. Summary: the paper’s exact predictability conditions&lt;/h2&gt;
&lt;p&gt;Evolution is predictable &lt;strong&gt;when all of the following hold&lt;/strong&gt;:&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;
&lt;strong&gt;SSWM or near-SSWM dynamics&lt;/strong&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;strong&gt;Sign epistasis restricts mutational order&lt;/strong&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;strong&gt;Few selectively accessible paths exist&lt;/strong&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;strong&gt;Population size is intermediate (greedy but not valley-crossing)&lt;/strong&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;strong&gt;Fitness landscape is rugged but structured&lt;/strong&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;strong&gt;Environment and selection pressures are stable&lt;/strong&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;Only under this combination does evolution become &lt;strong&gt;path-constrained and repeatable&lt;/strong&gt;.&lt;/p&gt;
&lt;hr&gt;
&lt;h3&gt;One-sentence takeaway&lt;/h3&gt;
&lt;blockquote&gt;
&lt;p&gt;&lt;strong&gt;Evolution is predictable when epistasis severely restricts accessible paths and population dynamics force selection to repeatedly choose the same uphill routes.&lt;/strong&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
