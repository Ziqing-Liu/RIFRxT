    <bib:Article rdf:about="https://academic.oup.com/jeb/article/26/8/1655-1664/7318880">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:1010-061X,%201420-9101"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Hall</foaf:surname>
                        <foaf:givenName>A. R.</foaf:givenName>
                    </foaf:Person>
