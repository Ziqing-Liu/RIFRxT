    <bib:Memo rdf:about="#item_39">
        <rdf:value>&lt;div data-citation-items=&quot;%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F3RDTNEVT%22%5D%2C%22itemData%22%3A%7B%22id%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F3RDTNEVT%22%2C%22type%22%3A%22article-journal%22%2C%22abstract%22%3A%22Bacteria%20have%20evolved%20diverse%20mechanisms%20to%20survive%20environments%20with%20antibiotics.%20Temperature%20is%20both%20a%20key%20factor%20that%20affects%20the%20survival%20of%20bacteria%20in%20the%20presence%20of%20antibiotics%20and%20an%20environmental%20trait%20that%20is%20drastically%20increasing%20due%20to%20climate%20change.%20Therefore%2C%20it%20is%20timely%20and%20important%20to%20understand%20links%20between%20temperature%20changes%20and%20selection%20of%20antibiotic%20resistance.%20This%20review%20examines%20these%20links%20by%20synthesizing%20results%20from%20laboratories%2C%20hospitals%2C%20and%20environmental%20studies.%20First%2C%20we%20describe%20the%20transient%20physiological%20responses%20to%20temperature%20that%20alter%20cellular%20behavior%20and%20lead%20to%20antibiotic%20tolerance%20and%20persistence.%20Second%2C%20we%20focus%20on%20the%20link%20between%20thermal%20stress%20and%20the%20evolution%20and%20maintenance%20of%20antibiotic%20resistance%20mutations.%20Finally%2C%20we%20explore%20how%20local%20and%20global%20changes%20in%20temperature%20are%20associated%20with%20increases%20in%20antibiotic%20resistance%20and%20its%20spread.%20We%20suggest%20that%20a%20multidisciplinary%2C%20multiscale%20approach%20is%20critical%20to%20fully%20understand%20how%20temperature%20changes%20are%20contributing%20to%20the%20antibiotic%20crisis.%22%2C%22container-title%22%3A%22iScience%22%2C%22DOI%22%3A%2210.1016%2Fj.isci.2020.101024%22%2C%22ISSN%22%3A%2225890042%22%2C%22issue%22%3A%224%22%2C%22journalAbbreviation%22%3A%22iScience%22%2C%22language%22%3A%22en%22%2C%22page%22%3A%22101024%22%2C%22source%22%3A%22DOI.org%20(Crossref)%22%2C%22title%22%3A%22Compounding%20Effects%20of%20Climate%20Warming%20and%20Antibiotic%20Resistance%22%2C%22URL%22%3A%22https%3A%2F%2Flinkinghub.elsevier.com%2Fretrieve%2Fpii%2FS258900422030208X%22%2C%22volume%22%3A%2223%22%2C%22author%22%3A%5B%7B%22family%22%3A%22Rodr%C3%ADguez-Verdugo%22%2C%22given%22%3A%22Alejandra%22%7D%2C%7B%22family%22%3A%22Lozano-Huntelman%22%2C%22given%22%3A%22Natalie%22%7D%2C%7B%22family%22%3A%22Cruz-Loya%22%2C%22given%22%3A%22Mauricio%22%7D%2C%7B%22family%22%3A%22Savage%22%2C%22given%22%3A%22Van%22%7D%2C%7B%22family%22%3A%22Yeh%22%2C%22given%22%3A%22Pamela%22%7D%5D%2C%22accessed%22%3A%7B%22date-parts%22%3A%5B%5B%222026%22%2C1%2C22%5D%5D%7D%2C%22issued%22%3A%7B%22date-parts%22%3A%5B%5B%222020%22%2C4%5D%5D%7D%7D%7D%5D&quot; data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FI425GMGK%22%2C%22pageLabel%22%3A%228%22%2C%22position%22%3A%7B%22pageIndex%22%3A7%2C%22rects%22%3A%5B%5B148.6612406199999%2C225.03791442000005%2C436.21330430000046%2C232.58569382000005%5D%2C%5B57.65669999999997%2C213.92665860000005%2C436.25156126000013%2C222.02677286000005%5D%2C%5B57.6567%2C203.15493330000004%2C165.0623181800001%2C210.70271270000003%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F3RDTNEVT%22%5D%2C%22locator%22%3A%228%22%7D%7D&quot;&gt;“Consequently, mutations conferring resistance to temperature stress can confer resistance to antibiotics and vice versa (Rodr ́ıguez-Verdugo et al., 2013), a phenomenon known as collateral resistance or cross-protection”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F3RDTNEVT%22%5D%2C%22locator%22%3A%228%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Rodríguez-Verdugo et al., 2020, p. 8&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FI425GMGK%22%2C%22pageLabel%22%3A%229%22%2C%22position%22%3A%7B%22pageIndex%22%3A8%2C%22rects%22%3A%5B%5B57.6567%2C110.0634414%2C436.3456096199997%2C117.6112208%5D%2C%5B57.65749702000002%2C99.12195084%2C436.28105100000033%2C106.66973023999999%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F3RDTNEVT%22%5D%2C%22locator%22%3A%229%22%7D%7D&quot;&gt;“Intriguingly, temperature can alleviate these fitness costs while preserving antibiotic resistance. In this way, they serve a similar genetic role as compensatory mutations that can also ameliorate these fitness costs”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F3RDTNEVT%22%5D%2C%22locator%22%3A%229%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Rodríguez-Verdugo et al., 2020, p. 9&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FI425GMGK%22%2C%22pageLabel%22%3A%2210%22%2C%22position%22%3A%7B%22pageIndex%22%3A9%2C%22rects%22%3A%5B%5B202.11024451999998%2C660.7784222%2C436.17411031999995%2C668.7089806399999%5D%2C%5B57.65576298000002%2C649.66716638%2C361.13945944000017%2C657.38471104%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F3RDTNEVT%22%5D%2C%22locator%22%3A%2210%22%7D%7D&quot;&gt;“rpoB mutations confer large fitness advantages at 42 C because they reset gene expression patterns from a stressed state toward an unstressed state”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F3RDTNEVT%22%5D%2C%22locator%22%3A%2210%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Rodríguez-Verdugo et al., 2020, p. 10&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FI425GMGK%22%2C%22pageLabel%22%3A%2210%22%2C%22position%22%3A%7B%22pageIndex%22%3A9%2C%22rects%22%3A%5B%5B385.51153402%2C605.7864332600001%2C436.25460934%2C613.50397792%5D%2C%5B57.65656000000001%2C595.01470796%2C436.28250504%2C602.56248736%5D%2C%5B57.65576298000002%2C584.0729222%2C415.7593016%2C592.0035664%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F3RDTNEVT%22%5D%2C%22locator%22%3A%2210%22%7D%7D&quot;&gt;“in some cases antibiotic resistance mutations are more detrimental at high temperatures (Gifford et al., 2016). Gifford et al. (2016) found that three rpoB mutations in P. aeruginosa are more costly at 42 C than at 37 C”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F3RDTNEVT%22%5D%2C%22locator%22%3A%2210%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Rodríguez-Verdugo et al., 2020, p. 10&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;</rdf:value>
