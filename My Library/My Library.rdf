    <bib:Article rdf:about="https://bsapubs.onlinelibrary.wiley.com/doi/10.1002/ajb2.16068">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:0002-9122,%201537-2197"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Gomulkiewicz</foaf:surname>
                        <foaf:givenName>Richard</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Stinchcombe</foaf:surname>
