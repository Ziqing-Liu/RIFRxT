                        <foaf:surname>Ackermann</foaf:surname>
                        <foaf:givenName>Martin</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Silander</foaf:surname>
                        <foaf:givenName>Olin K.</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
