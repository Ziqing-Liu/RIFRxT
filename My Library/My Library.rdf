    <bib:Memo rdf:about="#item_68">
        <rdf:value>&lt;div data-citation-items=&quot;%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FVA5B5Y7K%22%5D%2C%22itemData%22%3A%7B%22id%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FVA5B5Y7K%22%2C%22type%22%3A%22article-journal%22%2C%22abstract%22%3A%22The%20fitness%20effects%20of%20antibiotic%20resistance%20mutations%20are%20a%20major%20driver%20of%20resistance%20evolution.%20While%20the%20nutrient%20environment%20affects%20bacterial%20fitness%2C%20experimental%20studies%20of%20resistance%20typically%20measure%20fitness%20of%20mutants%20in%20a%20single%20environment%20only.%20We%20explored%20how%20the%20nutrient%20environment%20affected%20the%20fitness%20effects%20of%20rifampicin-resistant%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20rpoB%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20mutations%20in%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20Escherichia%20coli%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20under%20several%20conditions%20critical%20for%20the%20emergence%20and%20spread%20of%20resistance%E2%80%94the%20presence%20of%20primary%20or%20secondary%20antibiotic%2C%20or%20the%20absence%20of%20any%20antibiotic.%20Pervasive%20genotype-by-environment%20(GxE)%20interactions%20determined%20fitness%20in%20all%20experimental%20conditions%2C%20with%20rank%20order%20of%20fitness%20in%20the%20presence%20and%20absence%20of%20antibiotics%20being%20strongly%20dependent%20on%20the%20nutrient%20environment.%20GxE%20interactions%20also%20affected%20the%20magnitude%20and%20direction%20of%20collateral%20effects%20of%20secondary%20antibiotics%2C%20in%20some%20cases%20so%20drastically%20that%20a%20mutant%20that%20was%20highly%20sensitive%20in%20one%20nutrient%20environment%20exhibited%20cross-resistance%20to%20the%20same%20antibiotic%20in%20another.%20It%20is%20likely%20that%20the%20mutant-specific%20impact%20of%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20rpoB%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20mutations%20on%20the%20global%20transcriptome%20underpins%20the%20observed%20GxE%20interactions.%20The%20pervasive%2C%20mutant-specific%20GxE%20interactions%20highlight%20the%20importance%20of%20doing%20what%20is%20rarely%20done%20when%20studying%20the%20evolution%20and%20spread%20of%20resistance%20in%20experimental%20and%20clinical%20work%3A%20assessing%20fitness%20of%20antibiotic-resistant%20mutants%20across%20a%20range%20of%20relevant%20environments.%22%2C%22container-title%22%3A%22Proceedings%20of%20the%20Royal%20Society%20B%3A%20Biological%20Sciences%22%2C%22DOI%22%3A%2210.1098%2Frspb.2023.1030%22%2C%22ISSN%22%3A%220962-8452%2C%201471-2954%22%2C%22issue%22%3A%222005%22%2C%22journalAbbreviation%22%3A%22Proc.%20R.%20Soc.%20B.%22%2C%22language%22%3A%22en%22%2C%22page%22%3A%2220231030%22%2C%22source%22%3A%22DOI.org%20(Crossref)%22%2C%22title%22%3A%22Pervasive%20genotype-by-environment%20interactions%20shape%20the%20fitness%20effects%20of%20antibiotic%20resistance%20mutations%22%2C%22URL%22%3A%22https%3A%2F%2Froyalsocietypublishing.org%2Fdoi%2F10.1098%2Frspb.2023.1030%22%2C%22volume%22%3A%22290%22%2C%22author%22%3A%5B%7B%22family%22%3A%22Soley%22%2C%22given%22%3A%22Jake%20K.%22%7D%2C%7B%22family%22%3A%22Jago%22%2C%22given%22%3A%22Matthew%22%7D%2C%7B%22family%22%3A%22Walsh%22%2C%22given%22%3A%22Calum%20J.%22%7D%2C%7B%22family%22%3A%22Khomarbaghi%22%2C%22given%22%3A%22Zahra%22%7D%2C%7B%22family%22%3A%22Howden%22%2C%22given%22%3A%22Benjamin%20P.%22%7D%2C%7B%22family%22%3A%22Lagator%22%2C%22given%22%3A%22Mato%22%7D%5D%2C%22accessed%22%3A%7B%22date-parts%22%3A%5B%5B%222026%22%2C2%2C2%5D%5D%7D%2C%22issued%22%3A%7B%22date-parts%22%3A%5B%5B%222023%22%2C8%2C30%5D%5D%7D%7D%7D%5D&quot; data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F7N3HZVID%22%2C%22pageLabel%22%3A%228%22%2C%22position%22%3A%7B%22pageIndex%22%3A7%2C%22rects%22%3A%5B%5B228.30489999999995%2C514.4964%2C283.47489999999993%2C523.2894%5D%2C%5B42.5197%2C502.4778%2C283.51%2C511.2708%5D%2C%5B42.5197%2C490.5159%2C283.5261999999999%2C499.3089%5D%2C%5B42.5197%2C478.4973%2C182.10249999999996%2C487.2903%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FVA5B5Y7K%22%5D%2C%22locator%22%3A%228%22%7D%7D&quot;&gt;“we found that GxE interactions could alter the rank order of mutant fitness, while also affecting the direction and the strength of collateral effects against secondary antibiotics”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FVA5B5Y7K%22%5D%2C%22locator%22%3A%228%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Soley et al., 2023, p. 8&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F7N3HZVID%22%2C%22pageLabel%22%3A%228%22%2C%22position%22%3A%7B%22pageIndex%22%3A7%2C%22rects%22%3A%5B%5B325.98549999999994%2C730.5666%2C552.7864000000003%2C739.3596%5D%2C%5B311.81229999999994%2C718.548%2C552.7711000000002%2C727.341%5D%2C%5B311.81229999999994%2C706.5294%2C552.8206000000002%2C715.3224%5D%2C%5B311.81229999999994%2C694.5675%2C552.7729%2C703.3605%5D%2C%5B311.81229999999994%2C682.5489%2C331.9174%2C691.8459%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FVA5B5Y7K%22%5D%2C%22locator%22%3A%228%22%7D%7D&quot;&gt;“Environmental variation influencing resistance profiles in such an unpredictable manner is particularly pertinent in clinical settings, where bacterial infections can colonize a variety of microenvironments and ecological niches around the human body”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FVA5B5Y7K%22%5D%2C%22locator%22%3A%228%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Soley et al., 2023, p. 8&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F7N3HZVID%22%2C%22pageLabel%22%3A%228%22%2C%22position%22%3A%7B%22pageIndex%22%3A7%2C%22rects%22%3A%5B%5B370.37620000000004%2C682.5489%2C552.8098000000001%2C691.8459%5D%2C%5B311.8123%2C670.5303%2C552.7693000000006%2C679.3233%5D%2C%5B311.8123%2C658.5684%2C552.8638000000004%2C667.3614%5D%2C%5B311.8123%2C646.5498%2C552.7738000000005%2C655.3428%5D%2C%5B311.8123%2C634.5312%2C442.42300000000023%2C643.3242%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FVA5B5Y7K%22%5D%2C%22locator%22%3A%228%22%7D%7D&quot;&gt;“Exploiting collateral sensitivity between antibiotics has been proposed as a novel therapeutic strategy that could slow down resistance evolution by exposing strains carrying resistance to one drug to a second antibiotic with an associated increase in sensitivity”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FVA5B5Y7K%22%5D%2C%22locator%22%3A%228%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Soley et al., 2023, p. 8&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
