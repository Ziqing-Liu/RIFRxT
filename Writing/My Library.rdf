            <dcterms:URI>
                <rdf:value>https://academic.oup.com/ismej/article/13/1/12-23/7475053</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-01-22 04:38:56</dcterms:dateSubmitted>
