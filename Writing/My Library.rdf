    <bib:Article rdf:about="https://pnas.org/doi/full/10.1073/pnas.1406886111">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:0027-8424,%201091-6490"/>
