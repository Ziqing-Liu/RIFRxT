    <bib:Article rdf:about="#item_273">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>124</prism:volume>
                <dc:title>Molecular Microbiology</dc:title>
                <dc:identifier>DOI 10.1111/mmi.70011</dc:identifier>
                <prism:number>4</prism:number>
                <dcterms:alternative>Molecular Microbiology</dcterms:alternative>
                <dc:identifier>ISSN 0950-382X, 1365-2958</dc:identifier>
