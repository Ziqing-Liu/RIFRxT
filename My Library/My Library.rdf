    <bib:Article rdf:about="https://academic.oup.com/mbe/article/doi/10.1093/molbev/msae187/7749770">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:0737-4038,%201537-1719"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>González-González</foaf:surname>
