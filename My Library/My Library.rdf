                <dc:identifier>ISSN 0737-4038, 1537-1719</dc:identifier>
            </bib:Journal>
        </dcterms:isPartOf>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Rodríguez-Verdugo</foaf:surname>
