        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Luria</foaf:surname>
                        <foaf:givenName>S E</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
