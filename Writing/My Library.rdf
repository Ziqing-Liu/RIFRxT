    <bib:Article rdf:about="https://academic.oup.com/mbe/article-lookup/doi/10.1093/molbev/msw239">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <dc:title>Molecular Biology and Evolution</dc:title>
                <dc:identifier>DOI 10.1093/molbev/msw239</dc:identifier>
                <dcterms:alternative>Mol Biol Evol</dcterms:alternative>
                <dc:identifier>ISSN 0737-4038, 1537-1719</dc:identifier>
            </bib:Journal>
        </dcterms:isPartOf>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Lind</foaf:surname>
                        <foaf:givenName>Peter A.</foaf:givenName>
                    </foaf:Person>
