    <bib:Memo rdf:about="#item_179">
        <rdf:value>&lt;div data-citation-items=&quot;%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F55YWXMQR%22%5D%2C%22itemData%22%3A%7B%22id%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F55YWXMQR%22%2C%22type%22%3A%22article-journal%22%2C%22abstract%22%3A%22Adaptations%20are%20constructed%20through%20the%20sequential%20substitution%20of%20bene%EF%AC%81cial%20mutations%20by%20natural%20selection.%20However%2C%20the%20rarity%20of%20bene%EF%AC%81cial%20mutations%20has%20precluded%20efforts%20to%20describe%20even%20their%20most%20basic%20properties.%20Do%20bene%EF%AC%81cial%20mutations%20typically%20confer%20small%20or%20large%20%EF%AC%81tness%20gains%3F%20Are%20their%20%EF%AC%81tness%20effects%20environment%20speci%EF%AC%81c%2C%20or%20are%20they%20broadly%20bene%EF%AC%81cial%20across%20a%20range%20of%20environments%3F%20To%20answer%20these%20questions%2C%20we%20used%20two%20subsets%20(n%20%C2%BC%2018%20and%20n%20%C2%BC%2063)%20of%20a%20large%20library%20of%20mutants%20carrying%20antibiotic%20resistance%20mutations%20in%20the%20bacterium%20Pseudomonas%20%EF%AC%82uorescens%20whose%20%EF%AC%81tness%2C%20along%20with%20the%20antibiotic%20sensitive%20ancestor%2C%20was%20assayed%20across%2095%20novel%20environments%20differing%20in%20the%20carbon%20source%20available%20for%20growth.%20We%20explore%20patterns%20of%20genotype-byenvironment%20(G%C2%B7E)%20interactions%20and%20ecological%20specialization%20among%20the%2018%20mutants%20initially%20found%20superior%20to%20the%20sensitive%20ancestor%20in%20one%20environment.%20We%20%EF%AC%81nd%20that%20G%C2%B7E%20is%20remarkably%20similar%20between%20the%20two%20sets%20of%20mutants%20and%20that%20bene%EF%AC%81cial%20mutants%20are%20not%20typically%20associated%20with%20large%20costs%20of%20adaptation.%20Fitness%20effects%20among%20bene%EF%AC%81cial%20mutants%20depart%20from%20a%20strict%20exponential%20distribution%3A%20they%20assume%20a%20variety%20of%20shapes%20that%20are%20often%20roughly%20L%20shaped%20but%20always%20right%20truncated.%20Distributions%20of%20(bene%EF%AC%81cial)%20%EF%AC%81tness%20effects%20predicted%20by%20a%20landscape%20model%20assuming%20multiple%20traits%20underlying%20%EF%AC%81tness%20and%20a%20single%20optimum%20often%20provide%20a%20good%20description%20of%20the%20empirical%20distributions%20in%20our%20data.%20Simulations%20of%20data%20sets%20containing%20a%20mixture%20of%20single%20and%20double%20mutants%20under%20this%20landscape%20show%20that%20inferences%20about%20the%20distribution%20of%20%EF%AC%81tness%20effects%20of%20bene%EF%AC%81cial%20mutants%20is%20quite%20robust%20to%20contamination%20by%20second-site%20mutations.%22%2C%22container-title%22%3A%22Genetics%22%2C%22DOI%22%3A%2210.1534%2Fgenetics.111.130468%22%2C%22ISSN%22%3A%221943-2631%22%2C%22issue%22%3A%223%22%2C%22language%22%3A%22en%22%2C%22license%22%3A%22https%3A%2F%2Facademic.oup.com%2Fjournals%2Fpages%2Fopen_access%2Ffunder_policies%2Fchorus%2Fstandard_publication_model%22%2C%22page%22%3A%22939-949%22%2C%22source%22%3A%22DOI.org%20(Crossref)%22%2C%22title%22%3A%22Cost%20of%20Adaptation%20and%20Fitness%20Effects%20of%20Beneficial%20Mutations%20in%20%3Ci%3EPseudomonas%20fluorescens%3C%2Fi%3E%22%2C%22URL%22%3A%22https%3A%2F%2Facademic.oup.com%2Fgenetics%2Farticle%2F189%2F3%2F939%2F6063865%22%2C%22volume%22%3A%22189%22%2C%22author%22%3A%5B%7B%22family%22%3A%22Bataillon%22%2C%22given%22%3A%22Thomas%22%7D%2C%7B%22family%22%3A%22Zhang%22%2C%22given%22%3A%22Tianyi%22%7D%2C%7B%22family%22%3A%22Kassen%22%2C%22given%22%3A%22Rees%22%7D%5D%2C%22accessed%22%3A%7B%22date-parts%22%3A%5B%5B%222026%22%2C1%2C28%5D%5D%7D%2C%22issued%22%3A%7B%22date-parts%22%3A%5B%5B%222011%22%2C11%2C1%5D%5D%7D%7D%7D%5D&quot; data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FLWG6YF6I%22%2C%22pageLabel%22%3A%22947%22%2C%22position%22%3A%7B%22pageIndex%22%3A8%2C%22rects%22%3A%5B%5B320.93870716%2C296.2638296999999%2C554.00258924%2C304.6589298999999%5D%2C%5B308.97639921999996%2C284.3015217599999%2C554.0451799400004%2C292.6966219599999%5D%2C%5B308.97639921999996%2C272.3392138199999%2C554.0413941000002%2C280.7343140199999%5D%2C%5B308.97639921999996%2C260.37690587999987%2C554.0177326000002%2C268.77200607999987%5D%2C%5B308.97639921999996%2C248.4713855399999%2C554.0205719800001%2C256.86648573999986%5D%2C%5B308.97639921999996%2C236.5090775999999%2C461.83536798000006%2C244.9041777999999%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F55YWXMQR%22%5D%2C%22locator%22%3A%22947%22%7D%7D&quot;&gt;“These results have at least two important implications. First, the evolution of specialization underlain by costs of adaptation is unlikely to occur through the substitution of a single mutation. Costs of adaptation, when they are found, are likely to be built up through the substitution of multiple mutations contributing to adaptation”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F55YWXMQR%22%5D%2C%22locator%22%3A%22947%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Bataillon et al., 2011, p. 947&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
