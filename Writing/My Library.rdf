    <bib:Article rdf:about="#item_211">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>33</prism:volume>
                <dc:title>Molecular Biology and Evolution</dc:title>
                <dc:identifier>DOI 10.1093/molbev/msv228</dc:identifier>
                <prism:number>1</prism:number>
                <dcterms:alternative>Mol Biol Evol</dcterms:alternative>
                <dc:identifier>ISSN 0737-4038, 1537-1719</dc:identifier>
