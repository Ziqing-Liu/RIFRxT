    </bib:Journal>
    <bib:Memo rdf:about="#item_49">
        <rdf:value>&lt;div data-citation-items=&quot;%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F36URLD85%22%5D%2C%22itemData%22%3A%7B%22id%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F36URLD85%22%2C%22type%22%3A%22article-journal%22%2C%22abstract%22%3A%22Significance%5Cn%20%20%20%20%20%20%20%20%20%20%20%20Tradeoffs%20are%20a%20basic%20assumption%20in%20evolutionary%20models.%20Demonstrating%20their%20prevalence%20has%20been%20difficult%2C%20however.%20In%20this%20work%2C%20we%20used%20large-scale%20experimental%20evolution%20with%20bacteria%20to%20assess%20the%20prevalence%20of%20fitness%20tradeoffs%20after%20high-temperature%20stress%20adaptation.%20Combining%20measurements%20of%20phenotypic%20variation%20with%20genome-scale%20approaches%2C%20our%20work%20shows%20that%20some%20populations%20adapt%20with%20fitness%20tradeoffs%20at%20low%20temperatures%2C%20whereas%20others%20adapt%20without%20a%20measurable%20tradeoff.%20The%20presence%20or%20absence%20of%20tradeoffs%20is%20associated%20in%20part%20with%20two%20different%20adaptive%20genetic%20pathways%20to%20thermal%20stress.%20Overall%2C%20our%20work%20provides%20insights%20into%20the%20prevalence%20of%20tradeoffs%20and%20the%20underlying%20genetic%20complexities%20that%20contribute%20to%20them.%5Cn%20%20%20%20%20%20%20%20%20%20%2C%20%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20Fitness%20tradeoffs%20are%20often%20assumed%20by%20evolutionary%20theory%2C%20yet%20little%20is%20known%20about%20the%20frequency%20of%20fitness%20tradeoffs%20during%20stress%20adaptation.%20Even%20less%20is%20known%20about%20the%20genetic%20factors%20that%20confer%20these%20tradeoffs%20and%20whether%20alternative%20adaptive%20mutations%20yield%20contrasting%20tradeoff%20dynamics.%20We%20addressed%20these%20issues%20using%20114%20clones%20of%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20Escherichia%20coli%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20that%20were%20evolved%20independently%20for%202%2C000%20generations%20under%20thermal%20stress%20(42.2%20%C2%B0C).%20For%20each%20clone%2C%20we%20measured%20their%20fitness%20relative%20to%20the%20ancestral%20clone%20at%2037%20%C2%B0C%20and%2020%20%C2%B0C.%20Tradeoffs%20were%20common%20at%2037%20%C2%B0C%20but%20more%20prevalent%20at%2020%20%C2%B0C%2C%20where%2056%25%20of%20clones%20were%20outperformed%20by%20the%20ancestor.%20We%20also%20characterized%20the%20upper%20and%20lower%20thermal%20boundaries%20of%20each%20clone.%20All%20clones%20shifted%20their%20upper%20boundary%20to%20at%20least%2045%20%C2%B0C%3B%20roughly%20half%20increased%20their%20lower%20niche%20boundary%20concomitantly%2C%20representing%20a%20shift%20of%20thermal%20niche.%20The%20remaining%20clones%20expanded%20their%20thermal%20niche%20by%20increasing%20their%20upper%20limit%20without%20a%20commensurate%20increase%20of%20lower%20limit.%20We%20associated%20these%20niche%20dynamics%20with%20genotypes%20and%20confirmed%20associations%20by%20engineering%20single%20mutations%20in%20the%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20rpoB%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20gene%2C%20which%20encodes%20the%20beta%20subunit%20of%20RNA%20polymerase%2C%20and%20the%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20rho%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20gene%2C%20which%20encodes%20a%20termination%20factor.%20Single%20mutations%20in%20the%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20rpoB%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20gene%20exhibit%20antagonistic%20pleiotropy%2C%20with%20fitness%20tradeoffs%20at%2018%20%C2%B0C%20and%20fitness%20benefits%20at%2042.2%20%C2%B0C.%20In%20contrast%2C%20a%20mutation%20within%20the%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20rho%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20transcriptional%20terminator%2C%20which%20defines%20an%20alternative%20adaptive%20pathway%20from%20that%20of%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20rpoB%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%2C%20had%20no%20demonstrable%20effect%20on%20fitness%20at%2018%20%C2%B0C.%20This%20study%20suggests%20that%20two%20different%20genetic%20pathways%20toward%20high-temperature%20adaptation%20have%20contrasting%20effects%20with%20respect%20to%20thermal%20tradeoffs.%22%2C%22container-title%22%3A%22Proceedings%20of%20the%20National%20Academy%20of%20Sciences%22%2C%22DOI%22%3A%2210.1073%2Fpnas.1406886111%22%2C%22ISSN%22%3A%220027-8424%2C%201091-6490%22%2C%22issue%22%3A%2233%22%2C%22journalAbbreviation%22%3A%22Proc.%20Natl.%20Acad.%20Sci.%20U.S.A.%22%2C%22language%22%3A%22en%22%2C%22page%22%3A%2212121-12126%22%2C%22source%22%3A%22DOI.org%20(Crossref)%22%2C%22title%22%3A%22Different%20tradeoffs%20result%20from%20alternate%20genetic%20adaptations%20to%20a%20common%20environment%22%2C%22URL%22%3A%22https%3A%2F%2Fpnas.org%2Fdoi%2Ffull%2F10.1073%2Fpnas.1406886111%22%2C%22volume%22%3A%22111%22%2C%22author%22%3A%5B%7B%22family%22%3A%22Rodr%C3%ADguez-Verdugo%22%2C%22given%22%3A%22Alejandra%22%7D%2C%7B%22family%22%3A%22Carrillo-Cisneros%22%2C%22given%22%3A%22David%22%7D%2C%7B%22family%22%3A%22Gonz%C3%A1lez-Gonz%C3%A1lez%22%2C%22given%22%3A%22Andrea%22%7D%2C%7B%22family%22%3A%22Gaut%22%2C%22given%22%3A%22Brandon%20S.%22%7D%2C%7B%22family%22%3A%22Bennett%22%2C%22given%22%3A%22Albert%20F.%22%7D%5D%2C%22accessed%22%3A%7B%22date-parts%22%3A%5B%5B%222026%22%2C1%2C22%5D%5D%7D%2C%22issued%22%3A%7B%22date-parts%22%3A%5B%5B%222014%22%2C8%2C19%5D%5D%7D%7D%7D%5D&quot; data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F3XGZM3IH%22%2C%22pageLabel%22%3A%226%22%2C%22position%22%3A%7B%22pageIndex%22%3A5%2C%22rects%22%3A%5B%5B270.07682166999996%2C178.4589995%2C283.41867606999995%2C186.7707596%5D%2C%5B38.37956%2C168.8776095%2C283.38370749999996%2C177.1893696%5D%2C%5B38.37956%2C159.3527095%2C283.41329629%2C167.6644696%5D%2C%5B38.37956%2C149.69331499999998%2C283.4285347699999%2C158.659615%5D%2C%5B38.37956%2C140.2464295%2C183.55292329999986%2C148.5581896%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F36URLD85%22%5D%2C%22locator%22%3A%226%22%7D%7D&quot;&gt;“Because the elongation speed of RNAP increases with increasing temperature (36), we hypothesize that adaptive mutations in rpoB slow RNAP transcription under thermal stress, leading to increased termination efficiency (37)”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F36URLD85%22%5D%2C%22locator%22%3A%226%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Rodríguez-Verdugo et al., 2014, p. 6&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F3XGZM3IH%22%2C%22pageLabel%22%3A%226%22%2C%22position%22%3A%7B%22pageIndex%22%3A5%2C%22rects%22%3A%5B%5B463.62785513000046%2C644.7012195%2C541.9153103200008%2C653.0129796%5D%2C%5B296.89861%2C634.872365%2C541.9350299%2C643.838665%5D%2C%5B296.89861%2C625.178005%2C541.9834566900003%2C634.144305%5D%2C%5B296.8995%2C615.4836349999999%2C541.9090365500003%2C624.449935%5D%2C%5B296.8995%2C605.9237694999999%2C541.9233733600007%2C614.2355296%5D%2C%5B296.8995%2C596.2294095%2C434.8487153900004%2C604.5411696%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F36URLD85%22%5D%2C%22locator%22%3A%226%22%7D%7D&quot;&gt;“RNAP mutants have the capacity to affect the expression of every gene, but rho influences termination in a subset of 20–50% of E. coli genes (42, 43). Because rpoB has the potential for more pleiotropic interactions, it likely also has a higher probability to generate fitness tradeoffs via antagonistic pleiotropy”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F36URLD85%22%5D%2C%22locator%22%3A%226%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Rodríguez-Verdugo et al., 2014, p. 6&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
