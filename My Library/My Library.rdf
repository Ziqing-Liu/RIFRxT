    <bib:Memo rdf:about="#item_403">
        <rdf:value>&lt;div data-citation-items=&quot;%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FUVZRUBHK%22%5D%2C%22itemData%22%3A%7B%22id%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FUVZRUBHK%22%2C%22type%22%3A%22article%22%2C%22abstract%22%3A%22Abstract%5Cn%20%20%20%20%20%20%20%20%20%20%5Cn%20%20%20%20%20%20%20%20%20%20%20%20Predicting%20the%20ability%20of%20bacteria%20to%20develop%20antibiotic%20resistance%20is%20challenging%2C%20especially%20for%20the%20vast%20majority%20of%20species%20for%20which%20no%20experimental%20data%20are%20available.%20Here%2C%20we%20investi-gated%20the%20evolvability%20and%20intrinsic%20presence%20of%20rifampicin%20resistance%20across%20the%20bacterial%20tree%20of%20life.%20We%20compiled%20a%20panel%20of%20known%20rifampicin%20resistance%20mutations%2C%20comprising%2060%20amino%20acid%20substitutions%20within%20the%20gene%5Cn%20%20%20%20%20%20%20%20%20%20%20%20rpoB%5Cn%20%20%20%20%20%20%20%20%20%20%20%20.%20We%20then%20screened%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%3E%5Cn%20%20%20%20%20%20%20%20%20%20%20%2018%20000%20genomes%20from%20all%20major%20bac-terial%20groups%20for%20the%20presence%20of%20those%20mutations%20and%20determined%20which%20mutations%20can%20evolve%20through%20point%20mutations.%20Our%20results%20demonstrate%20that%20although%20the%20evolvability%20of%20individual%20mutations%20varies%20considerably%20across%20species%2C%20overall%20predicted%20evolvability%20is%20high%20and%20relatively%20homogeneous%20across%20bacterial%20taxa.%20Rifampicin%20resistance%20mutations%20are%20present%20intrinsically%20in%208%25%20of%20species.%20Our%20analysis%20provides%20a%20global%20picture%20of%20the%20mutational%20landscape%20of%20rifampicin%20resistance%2C%20including%20both%20insight%20into%20existing%20observations%20as%20well%20as%20predictions%20informing%20future%20work.%22%2C%22DOI%22%3A%2210.1101%2F2024.11.05.622190%22%2C%22language%22%3A%22en%22%2C%22license%22%3A%22http%3A%2F%2Fcreativecommons.org%2Flicenses%2Fby-nc-nd%2F4.0%2F%22%2C%22publisher%22%3A%22Evolutionary%20Biology%22%2C%22source%22%3A%22DOI.org%20(Crossref)%22%2C%22title%22%3A%22Evolution%20and%20evolvability%20of%20rifampicin%20resistance%20across%20the%20bacterial%20tree%20of%20life%22%2C%22URL%22%3A%22http%3A%2F%2Fbiorxiv.org%2Flookup%2Fdoi%2F10.1101%2F2024.11.05.622190%22%2C%22author%22%3A%5B%7B%22family%22%3A%22Bolourchi%22%2C%22given%22%3A%22Negin%22%7D%2C%7B%22family%22%3A%22Brown%22%2C%22given%22%3A%22Christopher%20R.%20P.%22%7D%2C%7B%22family%22%3A%22Letten%22%2C%22given%22%3A%22Andrew%20D.%22%7D%2C%7B%22family%22%3A%22Engelst%C3%A4dter%22%2C%22given%22%3A%22Jan%22%7D%5D%2C%22accessed%22%3A%7B%22date-parts%22%3A%5B%5B%222026%22%2C2%2C5%5D%5D%7D%2C%22issued%22%3A%7B%22date-parts%22%3A%5B%5B%222024%22%2C11%2C6%5D%5D%7D%7D%7D%5D&quot; data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FRXN8C39B%22%2C%22pageLabel%22%3A%222%22%2C%22position%22%3A%7B%22pageIndex%22%3A1%2C%22rects%22%3A%5B%5B179.0279378%2C434.5373500000002%2C283.10722%2C443.6630916000002%5D%2C%5B37.03099999999999%2C423.4390606000002%2C283.10818939999996%2C432.7540916000002%5D%2C%5B37.03099999999998%2C412.7193500000002%2C283.1072200000001%2C421.8450916000002%5D%2C%5B37.03099999999998%2C401.8103500000002%2C283.10722%2C410.9360916000002%5D%2C%5B37.03099999999998%2C390.7120606000002%2C111.34203339999998%2C400.02709160000023%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FUVZRUBHK%22%5D%2C%22locator%22%3A%222%22%7D%7D&quot;&gt;“Mutations 526y and 526R (all positions in Escherichia coli coordinates) had the highest frequencies (reported in 30 and 26 species, respectively), and position 526 is also the position with the greatest number of reported mutations”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FUVZRUBHK%22%5D%2C%22locator%22%3A%222%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Bolourchi et al., 2024, p. 2&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
