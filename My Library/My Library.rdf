    <bib:Article rdf:about="https://academic.oup.com/mbe/article-lookup/doi/10.1093/molbev/msv228">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>33</prism:volume>
