        </dcterms:isPartOf>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Rodríguez-Verdugo</foaf:surname>
                        <foaf:givenName>Alejandra</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Tenaillon</foaf:surname>
                        <foaf:givenName>Olivier</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Gaut</foaf:surname>
                        <foaf:givenName>Brandon S.</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
