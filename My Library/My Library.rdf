            <dcterms:URI>
                <rdf:value>https://linkinghub.elsevier.com/retrieve/pii/S2001037024001788</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-02-10 07:12:14</dcterms:dateSubmitted>
        <bib:pages>2132-2140</bib:pages>
