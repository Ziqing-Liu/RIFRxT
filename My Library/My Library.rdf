    <bib:Memo rdf:about="#item_466">
        <rdf:value>&lt;div data-citation-items=&quot;%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FZ5PIDAS9%22%5D%2C%22itemData%22%3A%7B%22id%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FZ5PIDAS9%22%2C%22type%22%3A%22article-journal%22%2C%22abstract%22%3A%22Rifampicin-resistant%20tuberculosis%20(RR-TB)%20remains%20a%20major%20threat%20to%20global%20TB%20control%2C%20primarily%20driven%20by%20mutations%20in%20the%20rpoB%20gene%20of%20Mycobacterium%20tuberculosis%20(Mtb).%20Most%20resistance-conferring%20mutations%20occur%20within%20the%2081-base%20pair%20RIF%20resistance%20determining%20region%20(RRDR)%2C%20particularly%20at%20codons%20S450L%2C%20H445Y%2FD%2C%20and%20D435V%2C%20which%20are%20strongly%20associated%20with%20high%20level%20resistance.%20However%2C%20increasing%20evidence%20of%20low-frequency%20and%20disputed%20variants%20both%20within%20and%20beyond%20the%20RRDR%20reveals%20a%20broader%20genetic%20spectrum%20that%20contributes%20to%20diagnostic%20uncertainty%20and%20variable%20phenotypic%20outcomes.%20This%20review%20summarizes%20current%20knowledge%20of%20high%20frequency%2C%20low%20frequency%2C%20and%20disputed%20rpoB%20mutations%20and%20their%20implications%20for%20molecular%20detection%20of%20RIF%20resistance.%20Structural%20analyses%20show%20that%20specific%20amino%20acid%20substitutions%20alter%20key%20hydrogen%20bonds%20or%20create%20steric%20hindrance%20in%20the%20RIF-binding%20pocket%2C%20leading%20to%20diverse%20resistance%20levels.%20Despite%20the%20success%20of%20molecular%20platforms%20such%20as%20Xpert%20MTB%2FRIF%20and%20line%20probe%20assays%2C%20their%20hotspot-based%20detection%20limits%20sensitivity%20to%20noncanonical%20variants.%20Lowering%20the%20minimum%20inhibitory%20concentration%20(MIC)%20breakpoint%20and%20integrating%20sequencing-based%20approaches%2C%20such%20as%20targeted%20and%20whole-genome%20sequencing%2C%20can%20enhance%20detection%20accuracy.%20A%20combined%20genomic%20and%20phenotypic%20framework%20will%20be%20essential%20to%20close%20existing%20diagnostic%20gaps%20and%20advance%20precision%20guided%20management%20of%20RIF-resistant%20and%20multidrug-resistant%20tuberculosis.%22%2C%22container-title%22%3A%22Pathogens%22%2C%22DOI%22%3A%2210.3390%2Fpathogens15010016%22%2C%22ISSN%22%3A%222076-0817%22%2C%22issue%22%3A%221%22%2C%22journalAbbreviation%22%3A%22Pathogens%22%2C%22language%22%3A%22en%22%2C%22page%22%3A%2216%22%2C%22source%22%3A%22DOI.org%20(Crossref)%22%2C%22title%22%3A%22Beyond%20Hotspot%20Mutations%3A%20Diagnostic%20Relevance%20of%20High%20Frequency%2C%20Low%20Frequency%2C%20and%20Disputed%20rpoB%20Variants%20in%20Rifampicin-Resistant%20Mycobacterium%20tuberculosis%22%2C%22title-short%22%3A%22Beyond%20Hotspot%20Mutations%22%2C%22URL%22%3A%22https%3A%2F%2Fwww.mdpi.com%2F2076-0817%2F15%2F1%2F16%22%2C%22volume%22%3A%2215%22%2C%22author%22%3A%5B%7B%22family%22%3A%22Soidah%22%2C%22given%22%3A%22Siti%22%7D%2C%7B%22family%22%3A%22Subroto%22%2C%22given%22%3A%22Toto%22%7D%2C%7B%22family%22%3A%22Faizal%22%2C%22given%22%3A%22Irvan%22%7D%2C%7B%22family%22%3A%22Yusuf%22%2C%22given%22%3A%22Muhammad%22%7D%5D%2C%22accessed%22%3A%7B%22date-parts%22%3A%5B%5B%222026%22%2C4%2C14%5D%5D%7D%2C%22issued%22%3A%7B%22date-parts%22%3A%5B%5B%222025%22%2C12%2C22%5D%5D%7D%7D%7D%5D&quot; data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2F6QNZKQ6G%22%2C%22pageLabel%22%3A%226%22%2C%22position%22%3A%7B%22pageIndex%22%3A5%2C%22rects%22%3A%5B%5B187.653%2C223.65854679999998%2C559.2769189026001%2C233.24256799999998%5D%2C%5B166.394%2C209.7315468%2C559.667834252%2C219.31556799999998%5D%2C%5B166.394%2C195.8035468%2C559.2715220240001%2C205.387568%5D%2C%5B166.394%2C181.8755468%2C322.2784933594%2C191.459568%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FZ5PIDAS9%22%5D%2C%22locator%22%3A%226%22%7D%7D&quot;&gt;“Substitution at S450 disrupts a key intermolecular hydrogen bond between serine and RIF and introduces a hydrophobic leucine residue that causes steric hindrance, thereby markedly reducing drug affinity while preserving the overall structural integrity and catalytic function of the polymerase”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FZ5PIDAS9%22%5D%2C%22locator%22%3A%226%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Soidah et al., 2025, p. 6&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;</rdf:value>
