    <bib:Article rdf:about="#item_258">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>26</prism:volume>
                <dc:title>Journal of Evolutionary Biology</dc:title>
                <dc:identifier>DOI 10.1111/jeb.12172</dc:identifier>
                <prism:number>8</prism:number>
