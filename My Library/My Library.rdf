    <bib:Memo rdf:about="#item_431">
        <rdf:value>&lt;div data-citation-items=&quot;%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FSYSKB28E%22%5D%2C%22itemData%22%3A%7B%22id%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FSYSKB28E%22%2C%22type%22%3A%22article-journal%22%2C%22abstract%22%3A%22ABSTRACT%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20Resistance%20to%20rifampin%20(RIF)%20and%20rifabutin%20(RFB)%20in%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20Mycobacterium%20tuberculosis%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20is%20associated%20with%20mutations%20within%20an%2081-bp%20region%20of%20the%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20rpoB%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20gene%20(RIF%20resistance-determining%20region%20%5BRRDR%5D).%20Previous%20studies%20have%20shown%20that%20certain%20mutations%20in%20this%20region%20are%20more%20likely%20to%20confer%20high%20levels%20of%20RIF%20resistance%2C%20while%20others%20may%20be%20found%20in%20phenotypically%20susceptible%20isolates.%20In%20this%20study%2C%20we%20sought%20to%20determine%20the%20relationship%20between%20the%20MICs%20of%20RIF%20and%20RFB%20and%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20rpoB%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20RRDR%20mutations%20in%2032%20multidrug-resistant%20(MDR)%2C%204%20RIF-monoresistant%2C%20and%205%20susceptible%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20M.%20tuberculosis%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20clinical%20isolates.%20The%20MICs%20were%20determined%20using%20the%20MGIT%20960%20system.%20Mutations%20in%20the%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20rpoB%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20RRDR%20were%20determined%20by%20Sanger%20sequencing.%20RpoB%20proteins%20with%20mutations%20S531L%20(a%20change%20of%20S%20to%20L%20at%20position%20531)%2C%20S531W%2C%20H526Y%2C%20and%20H526D%20and%20the%20double%20mutation%20D516A-R529Q%20were%20associated%20with%20high%20MICs%20for%20RIF%20and%20RFB.%20Five%20isolates%20carrying%20the%20mutations%20L511P%2C%20H526L%2C%20H526N%2C%20and%20D516G-S522L%20were%20found%20to%20be%20susceptible%20to%20RIF.%20Several%20mutations%20were%20associated%20with%20resistance%20to%20RIF%20and%20susceptibility%20to%20RFB%20(F514FF%2C%20D516V%2C%20and%20S522L).%20Whole-genome%20sequencing%20of%20two%20MDR%20isolates%20without%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20rpoB%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20RRDR%20mutations%20revealed%20a%20mutation%20outside%20the%20RRDR%20(V146F%3B%20RIF%20MIC%20of%2050%20%CE%BCg%2Fml).%20The%20implications%20of%20the%20polymorphisms%20identified%20in%20the%20second%20of%20these%20isolates%20in%20RIF%20resistance%20need%20to%20be%20further%20explored.%20Our%20study%20further%20establishes%20a%20correlation%20between%20the%20mutations%20and%20the%20MICs%20of%20RIF%20and%2C%20also%2C%20RFB%20in%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20M.%20tuberculosis%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20.%20Several%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20rpoB%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20mutations%20were%20identified%20in%20RIF-%20and%20RFB-susceptible%20isolates.%20The%20clinical%20significance%20of%20these%20findings%20requires%20further%20exploration.%20Until%20then%2C%20a%20combination%20of%20phenotypic%20and%20molecular%20testing%20is%20advisable%20for%20drug%20susceptibility%20testing.%22%2C%22container-title%22%3A%22Journal%20of%20Clinical%20Microbiology%22%2C%22DOI%22%3A%2210.1128%2FJCM.00691-14%22%2C%22ISSN%22%3A%220095-1137%2C%201098-660X%22%2C%22issue%22%3A%226%22%2C%22journalAbbreviation%22%3A%22J%20Clin%20Microbiol%22%2C%22language%22%3A%22en%22%2C%22page%22%3A%222157-2162%22%2C%22source%22%3A%22DOI.org%20(Crossref)%22%2C%22title%22%3A%22Profiling%20of%20%3Ci%3ErpoB%3C%2Fi%3E%20Mutations%20and%20MICs%20for%20Rifampin%20and%20Rifabutin%20in%20Mycobacterium%20tuberculosis%22%2C%22URL%22%3A%22https%3A%2F%2Fjournals.asm.org%2Fdoi%2F10.1128%2FJCM.00691-14%22%2C%22volume%22%3A%2252%22%2C%22author%22%3A%5B%7B%22family%22%3A%22Jamieson%22%2C%22given%22%3A%22F.%20B.%22%7D%2C%7B%22family%22%3A%22Guthrie%22%2C%22given%22%3A%22J.%20L.%22%7D%2C%7B%22family%22%3A%22Neemuchwala%22%2C%22given%22%3A%22A.%22%7D%2C%7B%22family%22%3A%22Lastovetska%22%2C%22given%22%3A%22O.%22%7D%2C%7B%22family%22%3A%22Melano%22%2C%22given%22%3A%22R.%20G.%22%7D%2C%7B%22family%22%3A%22Mehaffy%22%2C%22given%22%3A%22C.%22%7D%5D%2C%22editor%22%3A%5B%7B%22family%22%3A%22Forbes%22%2C%22given%22%3A%22B.%20A.%22%7D%5D%2C%22accessed%22%3A%7B%22date-parts%22%3A%5B%5B%222026%22%2C3%2C27%5D%5D%7D%2C%22issued%22%3A%7B%22date-parts%22%3A%5B%5B%222014%22%2C6%5D%5D%7D%7D%7D%5D&quot; data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FLY3V3JDB%22%2C%22pageLabel%22%3A%222160%22%2C%22position%22%3A%7B%22pageIndex%22%3A3%2C%22rects%22%3A%5B%5B406.25314999999995%2C375.2297%2C553.5458999999998%2C383.6752%5D%2C%5B307.4997000000001%2C364.2295%2C553.5514999999998%2C372.67515000000003%5D%2C%5B307.4996%2C353.22945%2C553.5306000000002%2C361.67495%5D%2C%5B307.4996%2C342.2294%2C348.74859999999995%2C350.675%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FSYSKB28E%22%5D%2C%22locator%22%3A%222160%22%7D%7D&quot;&gt;“both H526N and L511P have previously been associated with RIF resistance (10, 25). However, these mutations are also part of a group of known disputed RIF-causing mutations,”&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F19606070%2Fitems%2FSYSKB28E%22%5D%2C%22locator%22%3A%222160%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Jamieson et al., 2014, p. 2160&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
&lt;/div&gt;</rdf:value>
