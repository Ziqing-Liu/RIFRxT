    <bib:Article rdf:about="https://onlinelibrary.wiley.com/doi/10.1111/mmi.70011">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:0950-382X,%201365-2958"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Yeh</foaf:surname>
                        <foaf:givenName>Melody</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Kelly</foaf:surname>
                        <foaf:givenName>Keilen</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Misra</foaf:surname>
                        <foaf:givenName>Rajeev</foaf:givenName>
                    </foaf:Person>
