    <bib:Article rdf:about="https://academic.oup.com/genetics/article/215/1/1/5930418">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>215</prism:volume>
                <dc:title>Genetics</dc:title>
                <dc:identifier>DOI 10.1534/genetics.120.303163</dc:identifier>
                <prism:number>1</prism:number>
                <dc:identifier>ISSN 1943-2631</dc:identifier>
            </bib:Journal>
        </dcterms:isPartOf>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Sommer</foaf:surname>
                        <foaf:givenName>Ralf J</foaf:givenName>
                    </foaf:Person>
